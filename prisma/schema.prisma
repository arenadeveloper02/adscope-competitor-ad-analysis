// **NOTE: dont remove updatedAt in any tables **
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalysisSession {
  id        String   @id @default(cuid())
  emailId   String
  domain    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
